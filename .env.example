# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# For local: mongodb://127.0.0.1:27017/pcte_travel
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pcte_travel?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/pcte_travel

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
